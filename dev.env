# Local development env vars. Mirrors what the platform injects in production.

# Standard processor env vars (platform-provided)
INPUT_DIR=/data/input
OUTPUT_DIR=/data/output
ENVIRONMENT=local
PENNSIEVE_API_HOST=https://api.pennsieve.net
PENNSIEVE_API_HOST2=https://api2.pennsieve.net
INTEGRATION_ID=local-quick-plot-001
EXECUTION_RUN_ID=local-run-001
SESSION_TOKEN=
REFRESH_TOKEN=
REGION=us-east-1
DEPLOYMENT_MODE=basic

# quick-plot specific
PROMPT="Plot the first numeric column as a histogram."
TARGET_FILE_NAME=sample.csv

# LLM Governor (set to a real Function URL for end-to-end local testing,
# or leave blank to use the stub LLM client in `processor.llm`)
LLM_GOVERNOR_URL=

# AWS credentials for SigV4 (only needed if LLM_GOVERNOR_URL is set)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
